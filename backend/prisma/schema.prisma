datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  WFH
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SuspiciousSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  allowedIps  String?    // Comma-separated whitelisted IP ranges for attendance
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  password         String
  role             Role           @default(EMPLOYEE)
  mfaEnabled       Boolean        @default(false)
  mfaSecret        String?
  
  // 1-to-1 relationship with Employee profile
  employee         Employee?
  
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  sessions         UserSession[]
  suspiciousActivities SuspiciousActivity[]
  dataAccessLogs   DataAccessLog[]

  loginAttempts    Int            @default(0)
  lockoutUntil     DateTime?
  deletedAt        DateTime?

  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  session   UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  ipAddress String?
  userAgent String?
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
}

model Employee {
  id               String             @id @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  
  departmentId     String?
  department       Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation      String?
  contactNumber    String?
  profilePicture   String?
  employmentStatus EmploymentStatus   @default(ACTIVE)
  dateOfJoining    DateTime           @default(now())
  
  // Self-referencing reporting structure
  managerId        String?
  manager          Employee?          @relation("EmployeeReporting", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates     Employee[]         @relation("EmployeeReporting")
  
  // Relations
  projectMemberships ProjectMember[]
  managedProjects    Project[]        @relation("ProjectLead")
  tasks              Task[]
  attendances        Attendance[]
  reviewsReceived    PerformanceReview[] @relation("Reviewee")
  reviewsGiven       PerformanceReview[] @relation("Reviewer")
  leaveRequests      LeaveRequest[]      @relation("LeaveApplicant")
  leaveApprovals     LeaveRequest[]      @relation("LeaveApprover")

  // Leave Balances
  casualBalance    Int                @default(15)
  sickBalance      Int                @default(10)
  earnedBalance    Int                @default(20)

  deletedAt        DateTime?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([managerId])
  @@index([departmentId])
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  status      ProjectStatus   @default(NOT_STARTED)
  priority    ProjectPriority @default(MEDIUM)

  managerId   String?         // Project Lead (Employee)
  manager     Employee?       @relation("ProjectLead", fields: [managerId], references: [id], onDelete: SetNull)
  
  members     ProjectMember[]
  tasks       Task[]

  deletedAt   DateTime?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([managerId])
}

model ProjectMember {
  id            String    @id @default(uuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleInProject String?   // e.g. "Lead Frontend Developer"
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([projectId, employeeId])
}

model Task {
  id          String     @id @default(uuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(TO_DO)
  dueDate     DateTime?

  assigneeId  String?
  assignee    Employee?  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  deletedAt   DateTime?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId])
  @@index([assigneeId])
}

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime         // UTC representation of day (YYYY-MM-DD)
  clockIn    DateTime
  clockOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  workHours  Float?

  logs       AttendanceLog[]

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
}

model AttendanceLog {
  id           String     @id @default(uuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  action       String     // "CLOCK_IN" or "CLOCK_OUT"
  timestamp    DateTime   @default(now())
  ipAddress    String?

  createdAt    DateTime   @default(now())
}

model PerformanceReview {
  id              String       @id @default(uuid())
  revieweeId      String
  reviewee        Employee     @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewerId      String
  reviewer        Employee     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  period          String       // E.g. "Q1 2026"
  
  // Categorized Skills (1-5)
  technicalSkills Int          @default(5)
  communication   Int          @default(5)
  teamwork        Int          @default(5)
  problemSolving  Int          @default(5)
  leadership      Int          @default(5)
  
  overallRating   Float        @default(5.0)
  feedback        String
  goals           String       // Stringified JSON goal list
  status          ReviewStatus @default(DRAFT)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([revieweeId])
  @@index([reviewerId])
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation("LeaveApplicant", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  LeaveType   @default(CASUAL)
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     LeaveStatus @default(PENDING)

  approverId String?
  approver   Employee?   @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([employeeId])
  @@index([approverId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // E.g. "PROJECT_ASSIGNMENT", "REVIEW_DUE"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail     String?
  action        String   // "LOGIN", "EMPLOYEE_CREATE", "PROJECT_CHANGE", etc.
  targetEntity  String?
  targetId      String?
  ipAddress     String?
  userAgent     String?
  previousValue String?  // stringified JSON
  newValue      String?  // stringified JSON
  metadata      Json?
  timestamp     DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}

model UserSession {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String?
  browser      String?
  ipAddress    String?
  userAgent    String?
  lastActivity DateTime       @default(now())
  revoked      Boolean        @default(false)
  revokedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@index([userId, revoked])
  @@index([lastActivity])
}

model SuspiciousActivity {
  id          String             @id @default(uuid())
  userId      String?
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        String
  severity    SuspiciousSeverity @default(MEDIUM)
  description String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  resolved    Boolean            @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime           @default(now())

  @@index([userId])
  @@index([severity])
  @@index([createdAt])
}

model DataAccessLog {
  id          String   @id @default(uuid())
  viewerId    String?
  viewer      User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  viewerEmail String?
  resource    String
  resourceId  String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([viewerId])
  @@index([resource])
  @@index([createdAt])
}
